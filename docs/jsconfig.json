{
    "compilerOptions": {
        "checkJs": true,
        "module": "ES2022",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": false,
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": true
    },
    "include": ["js/**/*.js", "tests/**/*.js"],
    "exclude": ["node_modules"]
}
